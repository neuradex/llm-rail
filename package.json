{
  "name": "llm-rail",
  "version": "0.1.0",
  "description": "Deterministic workflow control CLI for LLM agents",
  "type": "module",
  "keywords": ["claude-code-plugin", "llm", "workflow", "agent"],
  "bin": {
    "lrail": "./bin/llm-rail.js"
  },
  "files": [
    "dist/",
    "bin/",
    "builtins/",
    "learn/",
    ".claude-plugin/",
    "skills/",
    "agents/",
    "settings.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
